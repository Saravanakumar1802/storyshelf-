# Copy to .env and fill in. Never commit .env — keys live on the backend only.

# ── App ──
APP_ENV=development
# Comma-separated origins allowed to call the API (the Next.js site)
API_CORS_ORIGINS=http://localhost:3000,http://localhost:4000
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
RATE_LIMITS=true                  # per-client request limits (login, forms, AI, search, MCP)
TRUST_PROXY_HEADERS=false         # true on Render/Fly/etc., so limits use the real client IP
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# Seeded on first start
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Database ──
# MongoDB Atlas free M0 cluster (512 MB). The library stops importing books at STORAGE_BUDGET_MB.
MONGODB_URI=
MONGODB_DB=ai_library
STORAGE_BUDGET_MB=200

# ── LLM provider keys (free tiers only — never link billing) ──
GROQ_API_KEY=            # https://console.groq.com
GEMINI_API_KEY=          # https://aistudio.google.com (AI Studio key, no billing)
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
MISTRAL_API_KEY=         # https://console.mistral.ai (free "Experiment" plan)
GITHUB_MODELS_TOKEN=     # GitHub fine-grained PAT with the models:read permission
OPENROUTER_API_KEY=      # https://openrouter.ai — only ":free" models are used

# ── Model IDs (LiteLLM "provider/model" format). Change a model here, no code change. ──
LLM_GROQ_FAST=groq/llama-3.1-8b-instant
LLM_GROQ_SMART=groq/openai/gpt-oss-120b
LLM_CEREBRAS=cerebras/gpt-oss-120b
LLM_GEMINI=gemini/gemini-2.5-flash
LLM_GEMINI_LITE=gemini/gemini-2.5-flash-lite
LLM_MISTRAL=mistral/mistral-small-latest
LLM_GITHUB=github/gpt-4o-mini
LLM_OPENROUTER=openrouter/meta-llama/llama-3.3-70b-instruct:free

# ── AI behaviour ──
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AI_DAILY_QUOTA_PER_USER=100
AI_CACHE_TTL_HOURS=168
LLM_TIMEOUT_SECONDS=30

# ── Book ingest (Project Gutenberg, fetched once from a mirror, politely) ──
GUTENBERG_MIRROR=https://gutenberg.pglaf.org
HTTP_USER_AGENT=StoryShelfLibrary/1.0 (contact@example.com)
